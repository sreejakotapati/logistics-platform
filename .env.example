# ============================================================
#  Logistics Management Platform — Environment Template
#  Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# ---- Application ----
APP_NAME=logistics-platform
APP_ENV=local                 # local | staging | production
APP_DEBUG=true
API_BASE_PATH=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=info

# ---- PostgreSQL (four-role architecture; see docs/architecture/database-architecture.md) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logistics
# Owner/bootstrap role (image-created superuser; runs init scripts; bootstrap only)
POSTGRES_USER=logistics_owner
POSTGRES_PASSWORD=change_me_owner
# Runtime application role — NOSUPERUSER NOBYPASSRLS (RLS APPLIES). Backend connects as this.
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me_app
# Migration role — runs Alembic DDL
MIGRATION_DB_USER=logistics_migrator
MIGRATION_DB_PASSWORD=change_me_migrator
# Platform super-admin role — BYPASSRLS; cross-tenant platform operations ONLY
SUPERADMIN_DB_USER=app_superadmin
SUPERADMIN_DB_PASSWORD=change_me_superadmin
# Connection URLs
DATABASE_URL=postgresql+psycopg://app_user:change_me_app@postgres:5432/logistics
MIGRATION_DATABASE_URL=postgresql+psycopg://logistics_migrator:change_me_migrator@postgres:5432/logistics

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---- Auth / JWT (active-org context per locked decision #1) ----
JWT_SECRET=change_me_long_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token       # httpOnly, Secure, SameSite=Strict

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=logistics
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# ---- Notification providers (locked decision #4) ----
# Email — AWS SES
SES_REGION=ap-south-1
SES_ACCESS_KEY=change_me
SES_SECRET_KEY=change_me
SES_FROM_EMAIL=no-reply@example.com
# SMS — MSG91
MSG91_AUTH_KEY=change_me
MSG91_SENDER_ID=LOGIST
# WhatsApp — Meta WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=change_me
WHATSAPP_ACCESS_TOKEN=change_me
WHATSAPP_BUSINESS_ACCOUNT_ID=change_me
# Push — Firebase Cloud Messaging
FCM_PROJECT_ID=change_me
FCM_CREDENTIALS_JSON_PATH=/run/secrets/fcm.json

# ---- India-first compliance (locked decision #5) ----
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
EWAY_BILL_API_BASE=https://sandbox.ewaybill.example   # sandbox in non-prod
EWAY_BILL_USERNAME=change_me
EWAY_BILL_PASSWORD=change_me

# ---- Maps (tracking) ----
MAPS_PROVIDER=
MAPS_API_KEY=

# ---- Frontend (public; exposed to browser) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_ENV=local

# ---- Local dev auxiliary services (docker compose --profile dev) ----
# Email capture (Mailhog) for local testing instead of real SES
SMTP_HOST=mailhog
SMTP_PORT=1025
# MinIO provides the S3 API locally (see S3_* above); console at http://localhost:9001
