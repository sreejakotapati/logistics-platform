# ============================================================
#  STAGING template. Copy to .env.staging (git-ignored, chmod 600). Never commit real secrets.
# ============================================================
APP_ENV=staging
APP_DEBUG=false
LOG_LEVEL=info
API_BASE_PATH=/api/v1

# Reverse proxy / domain (Caddy)
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL (four-role architecture)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics_owner
POSTGRES_PASSWORD=__set_strong_secret__
APP_DB_USER=app_user
APP_DB_PASSWORD=__set_strong_secret__
MIGRATION_DB_USER=logistics_migrator
MIGRATION_DB_PASSWORD=__set_strong_secret__
SUPERADMIN_DB_USER=app_superadmin
SUPERADMIN_DB_PASSWORD=__set_strong_secret__
DATABASE_URL=postgresql+psycopg://app_user:__set_strong_secret__@postgres:5432/logistics
MIGRATION_DATABASE_URL=postgresql+psycopg://logistics_migrator:__set_strong_secret__@postgres:5432/logistics

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=__set_long_random_secret__
COOKIE_SECURE=true        # refresh cookie must carry the Secure flag outside local
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Notification providers (staging/sandbox credentials)
SES_REGION=ap-south-1
MSG91_AUTH_KEY=__set__
WHATSAPP_ACCESS_TOKEN=__set__
FCM_PROJECT_ID=__set__

# India-first
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# Frontend (public — inlined at build)
NEXT_PUBLIC_API_URL=https://staging.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://staging.example.com/ws
NEXT_PUBLIC_APP_ENV=staging
