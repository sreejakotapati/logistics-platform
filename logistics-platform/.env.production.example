# ============================================================
#  PRODUCTION template. Copy to .env.production (git-ignored).
#  Prefer a secret manager / Docker secrets over plain env files (see secrets/README.md).
# ============================================================
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning
API_BASE_PATH=/api/v1

STAGING_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics_owner
POSTGRES_PASSWORD=__from_secret_manager__
APP_DB_USER=app_user
APP_DB_PASSWORD=__from_secret_manager__
MIGRATION_DB_USER=logistics_migrator
MIGRATION_DB_PASSWORD=__from_secret_manager__
SUPERADMIN_DB_USER=app_superadmin
SUPERADMIN_DB_PASSWORD=__from_secret_manager__
DATABASE_URL=postgresql+psycopg://app_user:__from_secret_manager__@postgres:5432/logistics
MIGRATION_DATABASE_URL=postgresql+psycopg://logistics_migrator:__from_secret_manager__@postgres:5432/logistics

# Production Redis should require a password: redis://:PASSWORD@redis:6379/0
REDIS_URL=redis://redis:6379/0

JWT_SECRET=__from_secret_manager__
COOKIE_SECURE=true        # refresh cookie must carry the Secure flag outside local
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://app.example.com/ws
NEXT_PUBLIC_APP_ENV=production
